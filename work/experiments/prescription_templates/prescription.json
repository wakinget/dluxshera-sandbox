{
  "experiment": {
    "n_runs": 2,
    "run_id_prefix": "mc",
    "results_filename": "results.csv",
    "notes": "Template experiment-level note. Stored once in manifest.json notes."
  },
  "model": {
    "config_id": "SHERA_TESTBED_CONFIG"
  },
  "defaults": {
    "seed": 42,
    "optimizer": {
      "n_iter": 60,
      "base_lr": 0.5
    },
    "eigen": {
      "use_eigen": true,
      "whiten_basis": true,
      "truncate_k": null,
      "truncate_by_eigval": null
    },
    "init": {
      "mode": "prior"
    },
    "noise": {
      "add_noise": false
    },
    "fim": {
      "reuse_fim": false
    }
  },
  "overrides": {
    "config": {
      "diffractive_pupil_path": "data/diffractive_pupil.npy",
      "primary_noll_indices": [4, 5, 6, 7, 8, 9, 10, 11],
      "secondary_noll_indices": [4, 5, 6, 7, 8, 9, 10, 11],
      "dp_design_wavelength_m": 550e-9
    },
    "store": {
      "binary.x_position_as": 0.5,
      "imaging.exposure_time_s": 1800.0
    }
  },
  "infer_keys": [
    "binary.separation_as",
    "binary.position_angle_deg",
    "binary.x_position_as",
    "binary.y_position_as",
    "binary.log_flux_total",
    "binary.contrast",
    "system.plate_scale_as_per_pix",
    "primary.zernike_coeffs_nm",
    "secondary.zernike_coeffs_nm"
  ],
  "priors": {
    "binary.separation_as": {
      "dist": "Normal",
      "sigma": 1e-4
    },
    "binary.position_angle_deg": {
      "dist": "Uniform",
      "sigma": 1e-2
    },
    "binary.x_position_as": {
      "dist": "Normal",
      "sigma": 1e-3
    },
    "binary.y_position_as": {
      "dist": "Normal",
      "sigma": 1e-3
    },
    "binary.log_flux_total": {
      "dist": "LogNormal",
      "sigma": 1e-3
    },
    "binary.contrast": {
      "dist": "LogNormal",
      "sigma": 1e-3
    },
    "system.plate_scale_as_per_pix": {
      "dist": "LogNormal",
      "sigma": 1e-3
    },
    "primary.zernike_coeffs_nm": {
      "dist": "Normal",
      "sigma": 1e0
    },
    "secondary.zernike_coeffs_nm": {
      "dist": "Normal",
      "sigma": 1e0
    }
  }
}
