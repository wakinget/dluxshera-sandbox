{
  "experiment": {
    "n_runs": 5,
    "run_id_prefix": "mc",
    "results_filename": "results.csv",
    "notes": "Experiment-level notes. Briefly describe the experiment."
  },
  "model": {
    "config_id": "SHERA_TESTBED_CONFIG",
    "_comment": "Options: SHERA_TESTBED_CONFIG | SHERA_FLIGHT_CONFIG"
  },
  "defaults": {
    "seed": 42,
    "optimizer": {
      "kind": "sgd",
      "_kind_options": "sgd | adam",
      "kwargs": {},
      "_sgd_kwargs": {"momentum":  0.1, "nesterov":  true},
      "_adam_kwargs": {"b1":  0.9, "b2":  0.999, "eps":  1e-8, "nesterov": true},
      "n_iter": 50,
      "base_lr": 0.5,
      "loss": "map",
      "_loss_options": "nll | map"
    },
    "eigen": {
      "use_eigen": true,
      "whiten_basis": true,
      "truncate_k": null,
      "truncate_by_eigval": null
    },
    "init": {
      "mode": "prior",
      "_comment": "Options: prior | explicit"
    },
    "noise": {
      "add_noise": true
    },
    "fim": {
      "reuse_fim": false
    }
  },
  "overrides": {
    "config": {
      "_comment": "Config parameters are generally structural and require rebuilding the model. These may not be overriden later.",
      "_ignored": "Any keys starting with underscores are ignored during parsing.",
      "_pupil_npix": 256,
      "_psf_npix": 256,
      "_wavelength_m": 550e-9,
      "_bandwidth_m": 110e-9,
      "_n_lambda": 3,
      "_pixel_pitch_m": 6.5e-6,
      "_primary_noll_indices": [4, 5, 6, 7, 8, 9, 10, 11],
      "_secondary_noll_indices": [4, 5, 6, 7, 8, 9, 10, 11],
      "_diffractive_pupil_path": "data/diffractive_pupil.npy",
      "_dp_design_wavelength_m": 550e-9
    },
    "store": {
      "_comment": "Store parameters are not structural and may be overridden, these control the default data starting point (truth) experiment-wide.",
      "_binary.x_position_as": 0.0,
      "_binary.y_position_as": 0.0,
      "_binary.position_angle_deg": 90.0,
      "_binary.separation_as": 10.0,
      "_binary.contrast": 3.0,
      "_imaging.exposure_time_s": 1800.0,
      "_primary.zernike_coeffs_nm": [0, 0, 0, 0, 0, 0, 0, 0],
      "_secondary.zernike_coeffs_nm": [0, 0, 0, 0, 0, 0, 0, 0]
    }
  },
  "infer_keys": [
    "binary.separation_as",
    "binary.position_angle_deg",
    "binary.x_position_as",
    "binary.y_position_as",
    "binary.log_flux_total",
    "binary.contrast",
    "system.plate_scale_as_per_pix",
    "primary.zernike_coeffs_nm",
    "secondary.zernike_coeffs_nm"
  ],
  "priors": {
    "_comment": "These control default priors for each parameter. These may be overridden per-run",
    "binary.separation_as": {
      "dist": "Normal",
      "sigma": 1e-4
    },
    "binary.position_angle_deg": {
      "dist": "Uniform",
      "sigma": 1e-2
    },
    "binary.x_position_as": {
      "dist": "Normal",
      "sigma": 1e-3
    },
    "binary.y_position_as": {
      "dist": "Normal",
      "sigma": 1e-3
    },
    "binary.log_flux_total": {
      "dist": "LogNormal",
      "sigma": 1e-3
    },
    "binary.contrast": {
      "dist": "LogNormal",
      "sigma": 1e-3
    },
    "system.plate_scale_as_per_pix": {
      "dist": "LogNormal",
      "sigma": 1e-3
    },
    "primary.zernike_coeffs_nm": {
      "dist": "Normal",
      "sigma": 1e0
    },
    "secondary.zernike_coeffs_nm": {
      "dist": "Normal",
      "sigma": 1e0
    }
  }
}
